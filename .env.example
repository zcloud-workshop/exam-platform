# ========== 数据库 ==========
# 开发环境 (PostgreSQL 18, SSL 必需; 密码中的特殊字符需 URL 编码)
# 连接池参数: connection_limit=10 (单实例池上限, 与 PG max_connections 协调)
#             pool_timeout=10  (池耗尽时等待空闲连接的最长秒数)
#             connect_timeout=10 (建立 TCP 连接的最长秒数)
DATABASE_URL="postgresql://exam_app:CHANGE_ME@ip/exam_platform?schema=public&sslmode=require&connection_limit=10&pool_timeout=10&connect_timeout=10"
# 生产环境 (部署时设置 DATABASE_URL=$DATABASE_URL_PROD)
DATABASE_URL_PROD="postgresql://exam_app:CHANGE_ME@ip/exam_platform?schema=exam_platform&sslmode=require&connection_limit=10&pool_timeout=10&connect_timeout=10"
# E2E 测试会清空数据, 必须使用独立的 exam_test schema
TEST_DATABASE_URL="postgresql://exam_app:CHANGE_ME@ip/exam_platform?schema=exam_test&sslmode=require&connection_limit=10&pool_timeout=10&connect_timeout=10"

# ========== JWT ==========
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# ========== 服务 ==========
PORT=3000
# 生产环境必须配置允许访问 API 的前端域名, 多个域名用英文逗号分隔
CORS_ORIGIN="http://localhost:5173"
# 生产环境默认关闭 Swagger, 如确需开启则设置为 true
SWAGGER_ENABLED="false"

# ========== RustFS (S3 兼容) 配置 ==========
S3_ENDPOINT=""
S3_BUCKET="exam-platform"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="us-east-1"

# ========== AI 配置 (OpenAI 兼容接口) ==========
OPENAI_BASE_URL="https://api.deepseek.com"
OPENAI_API_KEY=""
OPENAI_MODEL="deepseek-flash"